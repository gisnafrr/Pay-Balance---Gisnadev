{
  "expo": {
    "name": "Pay-Balace",
    "slug": "pay-balace",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "paybalace",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/96c4b4b1-f528-46a6-980c-7bf7d75731d3"
    },
    "splash": {
      "backgroundColor": "#6D28D9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gisnadev.paybalace",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Gunakan Face ID untuk membuka kunci aplikasi Pay-Balace."
      }
    },
    "android": {
      "package": "com.gisnadev.paybalace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#6D28D9"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan Pay-Balace menggunakan Face ID untuk keamanan data keuangan Anda."
        }
      ]
    ],
    "extra": {
      "author": "gisnadev",
      "license": "MIT",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "96c4b4b1-f528-46a6-980c-7bf7d75731d3"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
